# 이 파일을 .env 로 복사하지 말고, Render의 Environment 화면에 같은 이름으로 넣어 주세요.
SECRET_KEY=아무도-모르는-긴-문자열
DEBUG=False
APP_NAME=순간카메라

# 앱 주소 (인스타그램이 사진을 가져갈 수 있어야 합니다)
PUBLIC_BASE_URL=https://내앱이름.onrender.com

# Claude API: AI 캡션 + 단체 사진 인원수 확인
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-haiku-5-5

# Instagram Graph API (크리에이터 계정). 비워 두면 '연습 모드'로 동작합니다.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_URL=https://graph.facebook.com/v21.0

# 사진 저장 위치 (Render 디스크를 붙였다면 그 경로)
MEDIA_ROOT=/var/data/media
